{
  "name": "skillet-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/server start",
    "typecheck": "bun run --cwd apps/server typecheck && bun run --cwd apps/web typecheck",
    "deadcode": "knip",
    "test:unit": "bun test --isolate",
    "test:browser": "bun run build && playwright test",
    "quality": "bun run typecheck && bun run deadcode && bun run test:unit && bun run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.11",
    "knip": "^6.35.1",
    "typescript": "5.9.3"
  }
}
